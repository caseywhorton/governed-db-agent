# Copy to .env and fill in. Never commit .env.
# Use letters and digits only in passwords, and no inline "# comments" after values.

# Langfuse tracing (free project at langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM for the LangGraph agent
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=

# Postgres (only needed for docker-compose and the Postgres backend)
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
POSTGRES_AGENT_PASSWORD=
# DB_BACKEND=postgres

# POSTGRES_REVIEWER_PASSWORD is deliberately NOT here. Export it only in the shell where
# you run approvals.py, so the agent's process (which loads .env) can't connect as the approver.
